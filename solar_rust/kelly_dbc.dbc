CM_ BO_ 217128453 "Message 1 broadcast (OUT IN ID 0x0CF11E05), period 50 ms.";
CM_ SG_ 217128453 SpeedRPM "Actual speed (RPM) = (MSB*256 + LSB), 1 rpm/bit; range 0–6000 rpm.";
CM_ SG_ 217128453 MotorCurrent "Actual current = (MSB*256 + LSB) / 10, 0.1 A/bit; raw range 0–4000 maps to 0–400 A.";
CM_ SG_ 217128453 BatteryVoltage "Actual voltage = (MSB*256 + LSB) / 10, 0.1 V/bit; raw range 0–1800 maps to 0–180 V.";
CM_ SG_ 217128453 IDError "ERR0 Identification error: Identification Angle operation failed; retry identification per Kelly instructions.";
CM_ SG_ 217128453 OverVoltage "ERR1 Over voltage: battery voltage too high; check battery volts and configuration.";
CM_ SG_ 217128453 LowVoltage "ERR2 Low voltage: battery voltage too low / under-voltage setting; check/charge battery.";
CM_ SG_ 217128453 Reserved51 "ERR3 reserved.";
CM_ SG_ 217128453 Stall "ERR4 stall: no speed feedback after controller outputs command for 2 seconds; may relate to speed sensors or phase wires.";
CM_ SG_ 217128453 InternalVoltsFault "ERR5 Internal volts fault: check B+/PWR wiring; possible excessive load on +5V supply; controller may be damaged.";
CM_ SG_ 217128453 OverTemperature "ERR6 Over temperature: controller temp exceeded 100°C; stops, restarts below 80°C.";
CM_ SG_ 217128453 ThrottleError "ERR7 Throttle error at power-up: valid throttle above TPS Low / dead zone at power-on; fault clears when throttle released; set correct pedal type if hall pedal.";
CM_ SG_ 217128453 Reserved56 "ERR8 Reserved.";
CM_ SG_ 217128453 InternalReset "ERR9 Internal reset: may be transient (temporary over-current or momentary high/low battery voltage).";
CM_ SG_ 217128453 HallThrottleOpen "ERR10 Hall throttle open/short-circuit: check throttle pedal wiring; restart clears after repair.";
CM_ SG_ 217128453 AngleSensorError "ERR11 Angle sensor error: speed sensor type error / incorrect wiring / sensor damaged or erratic feedback.";
CM_ SG_ 217128453 Reserved60 "ERR12 Reserved.";
CM_ SG_ 217128453 Reserved61 "ERR13 Reserved.";
CM_ SG_ 217128453 MotorOverTemperature "ERR14 Motor over-temperature: exceeds configured maximum; controller shuts down until motor cools; max temp configurable.";
CM_ SG_ 217128453 HallGalvanometerError "ERR15 Hall galvanometer sensor error: hall galvanometer device damaged; only valid for KLS-8080I.";
